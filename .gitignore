# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# Ambiente virtual
venv/
env/
.venv/

# Variáveis de ambiente / segredos
.env

# Banco de dados local (SQLite é só para desenvolvimento)
db.sqlite3
db.sqlite3-journal

